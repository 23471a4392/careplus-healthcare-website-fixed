{
  "name": "careplus-healthcare-portal",
  "version": "1.0.0",
  "description": "CarePlus Healthcare Portal — responsive front-end healthcare dashboard (demo)",
  "private": true,
  "type": "module",
  "main": "script.js",
  "scripts": {
    "start": "python3 -m http.server 8000",
    "serve": "npx --yes serve -l 8000",
    "build": "echo 'Static frontend — no compile step. Open index.html or use npm start.'",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch"
  },
  "keywords": ["healthcare", "portal", "dashboard", "appointments", "frontend"],
  "author": "CarePlus Engineering",
  "license": "UNLICENSED",
  "devDependencies": {
    "jest": "^29.7.0",
    "@jest/globals": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "collectCoverageFrom": ["assets/utils/**/*.js", "assets/modules/**/*.js"],
    "coverageDirectory": "coverage",
    "testMatch": ["**/tests/**/*.test.js"]
  },
  "engines": {
    "node": ">=18"
  }
}
